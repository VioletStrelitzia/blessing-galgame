# Godot 4+ specific ignores
.godot/
/android/
.vscode/
*.exe
*.pck
*.zip
*.7z
*.rar
*.tar
*.gz
*.bz2
*.xz

# 导出产物
/build/

# 编译产物（由 scripts/ 在首次运行时自动再生成）
/GalSs/

# 运行时产物
/Saves/
log.txt
/mods/

# 历史归档（开源前的完整 git 历史，仅本地保存）
/.git-archive/

# 过程稿/分析笔记（Issue 先行流程的本地材料，不入库）
/worknotes/
*.tmp

# 便携运行时（Godot/Node 免安装解压位，见 docs/AI部署指南.md）
/tools/

# Web 编辑器（editor/）前端产物
editor/node_modules/
editor/dist/
